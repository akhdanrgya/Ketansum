# Copy to .env.local and configure your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Demo never writes to Supabase. Set false when connecting production.
NEXT_PUBLIC_DEMO_MODE=false

# Server/local scripts only. Never prefix these with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
KETANSUM_ADMIN_EMAIL=admin@ketansum.com
KETANSUM_ADMIN_PASSWORD=

# Set to the exact HTTPS site origin on deployment.
APP_ORIGIN=
